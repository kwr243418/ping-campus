# 비밀값은 .env.local(로컬)과 Vercel 환경변수에만 넣습니다. NEXT_PUBLIC_ 접두사는 공개 키에만 씁니다.

# AI 추출 — 없으면 대체 파서로 동작 (이미지·시간표 캡처 인식은 키 필요)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web Push — `npx web-push generate-vapid-keys` 로 만듭니다. 없으면 앱 안 알림센터로만 동작
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Supabase — 없으면 서버 메모리 저장소(로컬 데모용, 서버 재시작 시 초기화)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 크론 라우트 인증 (Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=

# 학교 홈페이지 공지 수집 (FR-9) — 공지 목록 또는 RSS 주소
SCHOOL_NOTICE_URL=

# 데모 도구('가상 학과 친구가 등록하기', 테스트 시각 반영).
# 비워 두면 개발 서버에서만 켜지고 배포(production)에서는 꺼집니다. 배포한 앱으로 시연할 때만 true
# (켜면 가상 친구의 행사가 같은 학과·학년 실제 사용자에게도 보이고 알림 C가 갑니다)
ENABLE_DEMO_TOOLS=
